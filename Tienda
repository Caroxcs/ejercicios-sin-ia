Algoritmo tienda
	Inicio
		Definir ventas, total_ventas, prom_ventas, max_ventas Como Real
		Definir dias, dia_500, dia_actual, max_dia Como Entero
		
		total_ventas <- 0
		dia_actual <- 0
		max_ventas <- 0
		dia_500 <- 0
		dias <- 0
		max_dia <- 0
		
		Escribir "Ingrese las ventas del día 1 (-1 para finalizar)"
		Leer ventas
		
		Mientras ventas <> -1 Hacer
			dia_actual <- dia_actual + 1
			total_ventas <- total_ventas + ventas
			dias <- dias + 1
			
			Si ventas > 500 Entonces
				dia_500 <- dia_500 + 1
			FinSi
			
			Si ventas > max_ventas Entonces
				max_ventas <- ventas
				max_dia <- dia_actual
			FinSi
			Escribir "Ingrese otra venta o -1 para terminar"
			Leer ventas
		Fin Mientras	
		Si dias > 0 Entonces
			prom_ventas <- total_ventas / dias			
			Escribir "El total de ventas es de: ", total_ventas
			Escribir "El promedio de ventas es de: ", prom_ventas
			Escribir "La cantidad de días superiores a 500 es de: ", dia_500
			Escribir "El día con mayor venta fue: ", max_ventas
		FinSi
	Fin Algoritmo


